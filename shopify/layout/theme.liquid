<!doctype html>
{%- comment -%}
  The Aeroplane site as a Shopify theme. Every page of the store loads the same React app
  (assets/aeroplane.js), which reads the address and draws the page. Liquid supplies what only
  Shopify knows: the theme's asset address and each product's live variants, prices and stock.
  Built by `npm run build:shopify`; edit the source in /shopify and /src, not in dist-shopify.
{%- endcomment -%}
{%- liquid
  assign site_title = 'Aeroplane Basmati Rice | Buy Aged Basmati Rice & Staples Online'
  assign site_description = 'Aeroplane Basmati Rice: aged Indian basmati, rested for eight months before milling. Shop basmati, regional rice and kitchen staples from the house of Aeroplane.'
  if template.name == 'index'
    assign title = site_title
  else
    assign title = page_title | append: ' | Aeroplane Basmati Rice'
  endif
  assign description = page_description | default: site_description
  assign script = 'aeroplane.js' | asset_url
-%}
<html lang="en-IN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title | escape }}</title>
<meta name="description" content="{{ description | escape }}">
<meta name="theme-color" content="#FDFCF9">
<link rel="canonical" href="{{ canonical_url }}">
<meta property="og:type" content="{% if template.name == 'product' %}product{% else %}website{% endif %}">
<meta property="og:url" content="{{ canonical_url }}">
<meta property="og:locale" content="en_IN">
<meta property="og:site_name" content="Aeroplane Basmati Rice">
<meta property="og:title" content="{{ title | escape }}">
<meta property="og:description" content="{{ description | escape }}">
{%- if template.name == 'product' and product.featured_image %}
<meta property="og:image" content="https:{{ product.featured_image | image_url: width: 1200 }}">
{%- else %}
<meta property="og:image" content="https:{{ 'img-og.jpg' | asset_url }}">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
{%- endif %}
<meta name="twitter:card" content="summary_large_image">
<link rel="icon" type="image/png" sizes="64x64" href="{{ 'brand-favicon.png' | asset_url }}">
<link rel="apple-touch-icon" href="{{ 'brand-touch-icon.png' | asset_url }}">
{{ 'fonts-montserrat.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
{{ 'fonts-manrope.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
{%- if template.name == 'index' %}
<link rel="preload" as="image" media="(min-aspect-ratio: 1/1)" imagesrcset="{{ 'img-banner-16x9-s.webp' | asset_url }} 1280w, {{ 'img-banner-16x9.webp' | asset_url }} 1672w" imagesizes="100vw" fetchpriority="high">
<link rel="preload" as="image" media="(max-aspect-ratio: 1/1)" imagesrcset="{{ 'img-banner-9x16-s.webp' | asset_url }} 640w, {{ 'img-banner-9x16.webp' | asset_url }} 941w" imagesizes="100vw" fetchpriority="high">
{%- endif %}
{{ 'aeroplane.css' | asset_url | stylesheet_tag }}
{{ content_for_header }}
{%- comment -%}
  Read by src/host.ts. Variant titles are the pack sizes ("1 kg", "5 kg"), as set by
  shopify/products.csv. `plans` are the subscribe-and-save options, present once a subscriptions
  app (Shopify Subscriptions) has selling plans on the product. collections.all lists up to 50 products without pagination, which covers
  the 38 in the range; past that, move this list to a paginated template or the Storefront API.
{%- endcomment -%}
<script>
  window.__AEROPLANE__ = {
    assetBase: {{ script | split: 'aeroplane.js' | first | json }},
    version: {{ script | split: '?v=' | last | json }},
    variants: {
      {%- for item in collections.all.products -%}
        {{ item.handle | json }}: [
          {%- for variant in item.variants -%}
            {"id": {{ variant.id }}, "size": {{ variant.title | json }}, "price": {{ variant.price | divided_by: 100.0 }}, "was": {{ variant.compare_at_price | default: variant.price | divided_by: 100.0 }}, "available": {{ variant.available }}, "plans": [
              {%- for allocation in variant.selling_plan_allocations -%}
                {"id": {{ allocation.selling_plan.id }}, "name": {{ allocation.selling_plan.name | json }}, "price": {{ allocation.price | divided_by: 100.0 }}}
                {%- unless forloop.last %},{% endunless -%}
              {%- endfor -%}
            ]}
            {%- unless forloop.last %},{% endunless -%}
          {%- endfor -%}
        ]{%- unless forloop.last %},{% endunless -%}
      {%- endfor -%}
    }
  };
</script>
<script type="module" src="{{ script }}"></script>
</head>
<body>
<div id="root"></div>
{{ content_for_layout }}
</body>
</html>
