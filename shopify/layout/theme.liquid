<!doctype html>
{%- comment -%}
  The Aeroplane site as a Shopify theme. Every page of the store loads the same React app
  (assets/aeroplane.js), which reads the address and draws the page. Liquid supplies what only
  Shopify knows: the theme's asset address and each product's live variants, prices and stock.
  Built by `npm run build:shopify`; edit the source in /shopify and /src, not in dist-shopify.
{%- endcomment -%}
{%- liquid
  assign script = 'aeroplane.js' | asset_url
  comment
    The app asks for every theme file as <asset address><name>?v=<aeroplane.js's version> (src/host.ts).
    The banner preloads below use the same address, so the browser reuses them instead of fetching twice.
  endcomment
  assign asset_base = script | split: 'aeroplane.js' | first
  assign asset_version = script | split: '?v=' | last
-%}
<html lang="en-IN">
<head>
{%- comment -%}theme-check-disable RemoteAsset{%- endcomment -%}
<script async src="https://www.googletagmanager.com/gtm.js?id=GTM-NQNXSK73"></script>
{%- comment -%}theme-check-enable RemoteAsset{%- endcomment -%}
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
</script>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
{%- render 'aeroplane-seo', product: product, collection: collection, page: page, page_title: page_title, page_description: page_description, canonical_url: canonical_url, template: template %}
<meta name="theme-color" content="#FDFCF9">
<link rel="icon" type="image/png" sizes="64x64" href="{{ 'brand-favicon.png' | asset_url }}">
<link rel="apple-touch-icon" href="{{ 'brand-touch-icon.png' | asset_url }}">
{{ 'fonts-montserrat.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
{{ 'fonts-manrope.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
{%- if template.name == 'index' %}
<link rel="preload" as="image" media="(min-aspect-ratio: 1/1)" imagesrcset="{{ asset_base }}img-banner-wide-v3-s.webp?v={{ asset_version }} 1280w, {{ asset_base }}img-banner-wide-v3.webp?v={{ asset_version }} 1930w" imagesizes="100vw" fetchpriority="high">
<link rel="preload" as="image" media="(max-aspect-ratio: 1/1)" imagesrcset="{{ asset_base }}img-banner-9x16-v5-s.webp?v={{ asset_version }} 640w, {{ asset_base }}img-banner-9x16-v5.webp?v={{ asset_version }} 941w" imagesizes="100vw" fetchpriority="high">
{%- endif %}
{{ 'aeroplane.css' | asset_url | stylesheet_tag }}
{{ content_for_header }}
{%- comment -%}
  Old preview links (?preview_theme_id=...) for the theme that is already live put the visitor in a
  Shopify preview session, and Shopify then shows its black preview bar on every page. When that
  happens on the live theme, reload once with an empty preview_theme_id, which ends the session,
  then tidy the address. Previews of unpublished themes and the theme editor are left alone.
{%- endcomment -%}
<script>
  (function () {
    try {
      var url = new URL(location.href);
      var theme = window.Shopify && window.Shopify.theme;
      var previewing = document.querySelector('script[src*="/preview-bar/"]');
      if (previewing && theme && theme.role === 'main' && !window.Shopify.designMode && !sessionStorage.getItem('aeroplane-exit-preview')) {
        sessionStorage.setItem('aeroplane-exit-preview', '1');
        url.searchParams.set('preview_theme_id', '');
        location.replace(url.toString());
      } else if (url.searchParams.get('preview_theme_id') === '') {
        url.searchParams.delete('preview_theme_id');
        history.replaceState(history.state, '', url.toString());
      }
    } catch (e) {}
  })();
</script>
{%- comment -%}
  Read by src/host.ts. Variant titles are the pack sizes ("1 kg", "5 kg"), as set by
  shopify/products.csv. `plans` are the subscribe-and-save options, present once a subscriptions
  app (Shopify Subscriptions) has selling plans on the product. collections.all lists up to 50 products without pagination, which covers
  the 38 in the range; past that, move this list to a paginated template or the Storefront API.
{%- endcomment -%}
<script>
  window.__AEROPLANE__ = {
    assetBase: {{ script | split: 'aeroplane.js' | first | json }},
    version: {{ script | split: '?v=' | last | json }},
    filesBase: {{ settings.documents_url | default: 'https://aeroplane-rice.vercel.app' | json }},
    variants: {
      {%- for item in collections.all.products -%}
        {{ item.handle | json }}: [
          {%- for variant in item.variants -%}
            {"id": {{ variant.id }}, "size": {{ variant.title | json }}, "price": {{ variant.price | divided_by: 100.0 }}, "was": {{ variant.compare_at_price | default: variant.price | divided_by: 100.0 }}, "available": {{ variant.available }}, "plans": [
              {%- for allocation in variant.selling_plan_allocations -%}
                {"id": {{ allocation.selling_plan.id }}, "name": {{ allocation.selling_plan.name | json }}, "price": {{ allocation.price | divided_by: 100.0 }}}
                {%- unless forloop.last %},{% endunless -%}
              {%- endfor -%}
            ]}
            {%- unless forloop.last %},{% endunless -%}
          {%- endfor -%}
        ]{%- unless forloop.last %},{% endunless -%}
      {%- endfor -%}
    }
  };
</script>
<script type="module" src="{{ script }}"></script>
</head>
<body>
{%- comment -%}
  The templates write each page's words and links into #root, for crawlers and for anyone without
  JavaScript; the app replaces them as soon as it starts. On policy pages Shopify writes the policy
  text itself, which scripts/shopify-setup.mjs fills from src/policies.ts.
{%- endcomment -%}
<div id="root"><div class="store-fallback" style="max-width:60rem;margin:0 auto;padding:7rem 5vw">
  <nav aria-label="Site"><a href="{{ routes.root_url }}">Aeroplane Basmati Rice</a> · <a href="{{ routes.all_products_collection_url }}">Shop</a> · <a href="/pages/company">Company</a> · <a href="/pages/investors">Investors</a> · <a href="/pages/contact">Contact</a></nav>
  <main>{{ content_for_layout }}</main>
</div></div>
</body>
</html>
