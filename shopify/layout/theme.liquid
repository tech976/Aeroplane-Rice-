<!doctype html>
{%- comment -%}
  The Aeroplane site as a Shopify theme. Every page of the store loads the same React app
  (assets/aeroplane.js), which reads the address and draws the page. Liquid supplies what only
  Shopify knows: the theme's asset address and each product's live variants, prices and stock.
  Built by `npm run build:shopify`; edit the source in /shopify and /src, not in dist-shopify.
{%- endcomment -%}
{%- liquid
  assign site_title = 'Aeroplane Basmati Rice | Buy Aged Basmati Rice & Staples Online'
  assign site_description = 'Aeroplane Basmati Rice: aged Indian basmati, rested for eight months before milling. Shop basmati, regional rice and kitchen staples from the house of Aeroplane.'
  if template.name == 'index'
    assign title = site_title
  else
    assign title = page_title | append: ' | Aeroplane Basmati Rice'
  endif
  assign description = page_description | default: site_description
  assign script = 'aeroplane.js' | asset_url
-%}
<html lang="en-IN">
<head>
{%- comment -%}theme-check-disable RemoteAsset{%- endcomment -%}
<script async src="https://www.googletagmanager.com/gtm.js?id=GTM-NQNXSK73"></script>
{%- comment -%}theme-check-enable RemoteAsset{%- endcomment -%}
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
</script>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title | escape }}</title>
<meta name="description" content="{{ description | escape }}">
<meta name="theme-color" content="#FDFCF9">
<link rel="canonical" href="{{ canonical_url }}">
<meta property="og:type" content="{% if template.name == 'product' %}product{% else %}website{% endif %}">
<meta property="og:url" content="{{ canonical_url }}">
<meta property="og:locale" content="en_IN">
<meta property="og:site_name" content="Aeroplane Basmati Rice">
<meta property="og:title" content="{{ title | escape }}">
<meta property="og:description" content="{{ description | escape }}">
{%- if template.name == 'product' and product.featured_image %}
<meta property="og:image" content="https:{{ product.featured_image | image_url: width: 1200 }}">
{%- else %}
<meta property="og:image" content="https:{{ 'img-og.jpg' | asset_url }}">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
{%- endif %}
<meta name="twitter:card" content="summary_large_image">
<link rel="icon" type="image/png" sizes="64x64" href="{{ 'brand-favicon.png' | asset_url }}">
<link rel="apple-touch-icon" href="{{ 'brand-touch-icon.png' | asset_url }}">
{{ 'fonts-montserrat.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
{{ 'fonts-manrope.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
{%- if template.name == 'index' %}
<link rel="preload" as="image" media="(min-aspect-ratio: 1/1)" imagesrcset="{{ 'img-banner-16x9-v2-s.webp' | asset_url }} 1280w, {{ 'img-banner-16x9-v2.webp' | asset_url }} 1920w" imagesizes="100vw" fetchpriority="high">
<link rel="preload" as="image" media="(max-aspect-ratio: 1/1)" imagesrcset="{{ 'img-banner-9x16-v4-s.webp' | asset_url }} 640w, {{ 'img-banner-9x16-v4.webp' | asset_url }} 941w" imagesizes="100vw" fetchpriority="high">
{%- endif %}
{{ 'aeroplane.css' | asset_url | stylesheet_tag }}
{{ content_for_header }}
{%- comment -%}
  Read by src/host.ts. Variant titles are the pack sizes ("1 kg", "5 kg"), as set by
  shopify/products.csv. `plans` are the subscribe-and-save options, present once a subscriptions
  app (Shopify Subscriptions) has selling plans on the product. collections.all lists up to 50 products without pagination, which covers
  the 38 in the range; past that, move this list to a paginated template or the Storefront API.
{%- endcomment -%}
<script>
  window.__AEROPLANE__ = {
    assetBase: {{ script | split: 'aeroplane.js' | first | json }},
    version: {{ script | split: '?v=' | last | json }},
    filesBase: {{ settings.documents_url | default: 'https://aeroplane-rice.vercel.app' | json }},
    variants: {
      {%- for item in collections.all.products -%}
        {{ item.handle | json }}: [
          {%- for variant in item.variants -%}
            {"id": {{ variant.id }}, "size": {{ variant.title | json }}, "price": {{ variant.price | divided_by: 100.0 }}, "was": {{ variant.compare_at_price | default: variant.price | divided_by: 100.0 }}, "available": {{ variant.available }}, "plans": [
              {%- for allocation in variant.selling_plan_allocations -%}
                {"id": {{ allocation.selling_plan.id }}, "name": {{ allocation.selling_plan.name | json }}, "price": {{ allocation.price | divided_by: 100.0 }}}
                {%- unless forloop.last %},{% endunless -%}
              {%- endfor -%}
            ]}
            {%- unless forloop.last %},{% endunless -%}
          {%- endfor -%}
        ]{%- unless forloop.last %},{% endunless -%}
      {%- endfor -%}
    }
  };
</script>
<script type="module" src="{{ script }}"></script>
</head>
<body>
{%- comment -%}
  COMING SOON (Nov 2026): a full-screen layer over every page, with no way to close it. The store
  still runs underneath it. To take it down, delete everything from here to END COMING SOON.
  Team preview: open any page with ?preview=aeroplane to hide the layer in that browser, and
  ?preview=off to bring it back. The theme editor never shows it.
{%- endcomment -%}
{%- unless request.design_mode -%}
<script>
  (function () {
    var root = document.documentElement;
    try {
      var preview = new URLSearchParams(location.search).get('preview');
      if (preview === 'aeroplane') localStorage.setItem('aeroplane-preview', '1');
      if (preview === 'off') localStorage.removeItem('aeroplane-preview');
      if (localStorage.getItem('aeroplane-preview') === '1') root.classList.add('soon-off');
    } catch (e) {}
    // keep keyboard focus out of the page underneath
    document.addEventListener('DOMContentLoaded', function () {
      var page = document.getElementById('root');
      if (page && !root.classList.contains('soon-off')) page.setAttribute('inert', '');
    });
  })();
</script>
<style>
  html:not(.soon-off), html:not(.soon-off) body { overflow: hidden !important; }
  html.soon-off .soon { display: none !important; }
  .soon { position: fixed; inset: 0; z-index: 2147483647; width: 100%; height: 100%; display: grid; place-items: center; padding: 2rem 1.25rem; overflow: hidden; background: #322B6A; color: #FDFCF9; text-align: center; font-family: "Montserrat", "Helvetica Neue", Arial, sans-serif; }
  .soon::before { content: ""; position: absolute; inset: 0; background: #FDFCF9; opacity: .07; -webkit-mask: url("{{ 'brand-pattern-mask.svg' | asset_url }}") 0 0 / 30rem; mask: url("{{ 'brand-pattern-mask.svg' | asset_url }}") 0 0 / 30rem; }
  .soon__inner { position: relative; display: grid; justify-items: center; gap: clamp(1.25rem, 3vw, 2rem); }
  .soon__logo { display: block; width: auto; height: clamp(4.5rem, 12vw, 7.5rem); }
  .soon__rule { display: block; width: 4rem; height: 3px; background: #FFED00; }
  .soon__title { margin: 0; font-weight: 700; font-size: clamp(2.25rem, 10vw, 7.5rem); line-height: .95; letter-spacing: -.04em; text-transform: uppercase; }
  .soon__note { margin: 0; max-width: 26em; font-family: "Manrope", "Helvetica Neue", Arial, sans-serif; font-size: clamp(1rem, 1.6vw, 1.25rem); line-height: 1.5; opacity: .85; text-wrap: balance; }
</style>
<div class="soon" role="dialog" aria-modal="true" aria-labelledby="soon-title">
  <div class="soon__inner">
    <img class="soon__logo" src="{{ 'brand-logo-shield-white.png' | asset_url }}" alt="La-Taste Aeroplane Basmati" width="1212" height="641">
    <span class="soon__rule" aria-hidden="true"></span>
    <p class="soon__title" id="soon-title">Coming Soon</p>
    <p class="soon__note">Something new from the house of Aeroplane is on its way.</p>
  </div>
</div>
{%- endunless -%}
{%- comment -%} END COMING SOON {%- endcomment -%}
{%- comment -%}
  The templates write each page's words and links into #root, for crawlers and for anyone without
  JavaScript; the app replaces them as soon as it starts. On policy pages Shopify writes the policy
  text itself, which scripts/shopify-setup.mjs fills from src/policies.ts.
{%- endcomment -%}
<div id="root"><div class="store-fallback" style="max-width:60rem;margin:0 auto;padding:7rem 5vw">
  <nav aria-label="Site"><a href="{{ routes.root_url }}">Aeroplane Basmati Rice</a> · <a href="{{ routes.all_products_collection_url }}">Shop</a> · <a href="/pages/company">Company</a> · <a href="/pages/investors">Investors</a> · <a href="/pages/contact">Contact</a></nav>
  <main>{{ content_for_layout }}</main>
</div></div>
</body>
</html>
